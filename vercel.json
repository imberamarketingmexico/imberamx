{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://mx.imberacooling.com"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://qezrauybkpzcenqilwcw.supabase.co https://images.unsplash.com https://mx.imberacooling.com https://www.google-analytics.com https://*.google-analytics.com; connect-src 'self' https://qezrauybkpzcenqilwcw.supabase.co wss://qezrauybkpzcenqilwcw.supabase.co https://*.powerplatform.com https://*.environment.api.powerplatform.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; form-action 'self'; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/(images|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(encuesta|encuesta/.*|encuesta\\.html|encuesta-admin\\.html|encuesta\\.js|encuesta-admin\\.js|encuesta\\.css|encuesta-admin\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(supabase\\.js|papaparse\\.min\\.js|fonts\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(categoria\\.js|main\\.js|producto\\.js|catalog-data\\.js|admin\\.js|admin\\.css|chart\\.min\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.(sql|env|bak|conf|log)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/encuesta/superadmin",
      "destination": "/encuesta/superadmin/index.html"
    },
    {
      "source": "/encuesta/superadmin/",
      "destination": "/encuesta/superadmin/index.html"
    },
    {
      "source": "/encuesta-admin",
      "destination": "/encuesta-admin.html"
    },
    {
      "source": "/encuesta",
      "destination": "/encuesta/index.html"
    },
    {
      "source": "/encuesta/",
      "destination": "/encuesta/index.html"
    },
    {
      "source": "/storage/v1/object/public/:path*",
      "destination": "https://qezrauybkpzcenqilwcw.supabase.co/storage/v1/object/public/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://qezrauybkpzcenqilwcw.supabase.co/storage/v1/object/public/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin"
    },
    {
      "source": "/distribuidores",
      "destination": "/distribuidores.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/sostenibilidad",
      "destination": "/sostenibilidad.html"
    },
    {
      "source": "/nosotros",
      "destination": "/nosotros.html"
    },
    {
      "source": "/avisos-de-privacidad",
      "destination": "/avisos-de-privacidad.html"
    },
    {
      "source": "/aviso-privacidad-candidatos",
      "destination": "/aviso-privacidad-candidatos.html"
    },
    {
      "source": "/aviso-privacidad-clientes",
      "destination": "/aviso-privacidad-clientes.html"
    },
    {
      "source": "/aviso-privacidad-proveedores",
      "destination": "/aviso-privacidad-proveedores.html"
    },
    {
      "source": "/aviso-privacidad-visitantes",
      "destination": "/aviso-privacidad-visitantes.html"
    },
    {
      "source": "/aviso-privacidad-ptu",
      "destination": "/aviso-privacidad-ptu.html"
    },
    {
      "source": "/aviso-privacidad-datos-personales",
      "destination": "/aviso-privacidad-datos-personales.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/producto/:path*",
      "destination": "/producto"
    },
    {
      "source": "/categoria/:path*",
      "destination": "/categoria"
    },
    {
      "source": "/:cat(enfriadores|congeladores|healthcare|vitrinas|procesamiento-y-pesaje|fabricas-de-hielo|conservadores-de-hielo|cortinas-de-aire|camaras-de-conservacion|home-cooler|linea-profesional|coccion|procesamiento|accesorios|linea-cobalt|enfriadores-verticales|enfriadores-cerveceros|enfriadores-verticales-especiales|enfriadores-ecoinverter|enfriadores-inverter-bluetooth|enfriador-horizontal|congeladores-horizontales|congeladores-verticales|congeladores-horizontal-doble-temperatura|congeladores-horizontal-pta-cristal|vitrinas-cremeras|vitrinas-carniceras|pesaje|rebanadoras|molinos|sierras|refrigeradores-para-consultorios|refrigeradores-para-hospitales|refrigeradores-para-laboratorios)/:sub/:item",
      "destination": "/producto"
    },
    {
      "source": "/:cat(enfriadores|congeladores|healthcare|vitrinas|procesamiento-y-pesaje|fabricas-de-hielo|conservadores-de-hielo|cortinas-de-aire|camaras-de-conservacion|home-cooler|linea-profesional|coccion|procesamiento|accesorios|linea-cobalt|enfriadores-verticales|enfriadores-cerveceros|enfriadores-verticales-especiales|enfriadores-ecoinverter|enfriadores-inverter-bluetooth|enfriador-horizontal|congeladores-horizontales|congeladores-verticales|congeladores-horizontal-doble-temperatura|congeladores-horizontal-pta-cristal|vitrinas-cremeras|vitrinas-carniceras|pesaje|rebanadoras|molinos|sierras|refrigeradores-para-consultorios|refrigeradores-para-hospitales|refrigeradores-para-laboratorios)/:sub",
      "destination": "/categoria"
    },
    {
      "source": "/:cat(enfriadores|congeladores|healthcare|vitrinas|procesamiento-y-pesaje|fabricas-de-hielo|conservadores-de-hielo|cortinas-de-aire|camaras-de-conservacion|home-cooler|linea-profesional|coccion|procesamiento|accesorios|linea-cobalt|enfriadores-verticales|enfriadores-cerveceros|enfriadores-verticales-especiales|enfriadores-ecoinverter|enfriadores-inverter-bluetooth|enfriador-horizontal|congeladores-horizontales|congeladores-verticales|congeladores-horizontal-doble-temperatura|congeladores-horizontal-pta-cristal|vitrinas-cremeras|vitrinas-carniceras|pesaje|rebanadoras|molinos|sierras|refrigeradores-para-consultorios|refrigeradores-para-hospitales|refrigeradores-para-laboratorios)",
      "destination": "/categoria"
    }
  ]
}

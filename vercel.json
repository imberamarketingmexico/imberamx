{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://imberamx-u5gh.vercel.app"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://cdnjs.cloudflare.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://qezrauybkpzcenqilwcw.supabase.co https://images.unsplash.com https://mx.imberacooling.com; connect-src 'self' https://qezrauybkpzcenqilwcw.supabase.co wss://qezrauybkpzcenqilwcw.supabase.co; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; form-action 'self'; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/(images|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.(sql|env|bak|conf|log)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/storage/v1/object/public/:path*",
      "destination": "https://qezrauybkpzcenqilwcw.supabase.co/storage/v1/object/public/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://qezrauybkpzcenqilwcw.supabase.co/storage/v1/object/public/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin"
    },
    {
      "source": "/distribuidores",
      "destination": "/distribuidores.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/sostenibilidad",
      "destination": "/sostenibilidad.html"
    },
    {
      "source": "/nosotros",
      "destination": "/nosotros.html"
    },
    {
      "source": "/avisos-de-privacidad",
      "destination": "/avisos-de-privacidad.html"
    },
    {
      "source": "/aviso-privacidad-candidatos",
      "destination": "/aviso-privacidad-candidatos.html"
    },
    {
      "source": "/aviso-privacidad-clientes",
      "destination": "/aviso-privacidad-clientes.html"
    },
    {
      "source": "/aviso-privacidad-proveedores",
      "destination": "/aviso-privacidad-proveedores.html"
    },
    {
      "source": "/aviso-privacidad-visitantes",
      "destination": "/aviso-privacidad-visitantes.html"
    },
    {
      "source": "/aviso-privacidad-ptu",
      "destination": "/aviso-privacidad-ptu.html"
    },
    {
      "source": "/aviso-privacidad-datos-personales",
      "destination": "/aviso-privacidad-datos-personales.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/producto/:path*",
      "destination": "/producto"
    },
    {
      "source": "/categoria/:path*",
      "destination": "/categoria"
    },
    {
      "source": "/:cat(enfriadores|congeladores|healthcare|vitrinas|procesamiento-y-pesaje|fabricas-de-hielo|conservadores-de-hielo|cortinas-de-aire|camaras-de-conservacion|home-cooler|linea-profesional|coccion|procesamiento|accesorios|linea-cobalt)/:sub/:item",
      "destination": "/producto"
    },
    {
      "source": "/:cat(enfriadores|congeladores|healthcare|vitrinas|procesamiento-y-pesaje|fabricas-de-hielo|conservadores-de-hielo|cortinas-de-aire|camaras-de-conservacion|home-cooler|linea-profesional|coccion|procesamiento|accesorios|linea-cobalt)/:sub",
      "destination": "/categoria"
    },
    {
      "source": "/:cat(enfriadores|congeladores|healthcare|vitrinas|procesamiento-y-pesaje|fabricas-de-hielo|conservadores-de-hielo|cortinas-de-aire|camaras-de-conservacion|home-cooler|linea-profesional|coccion|procesamiento|accesorios|linea-cobalt)",
      "destination": "/categoria"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin"
    },
    {
      "source": "/distribuidores",
      "destination": "/distribuidores.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/sostenibilidad",
      "destination": "/sostenibilidad.html"
    },
    {
      "source": "/nosotros",
      "destination": "/nosotros.html"
    },
    {
      "source": "/producto/:path*",
      "destination": "/producto"
    },
    {
      "source": "/categoria/:path*",
      "destination": "/categoria"
    },
    {
      "source": "/:cat/:sub/:item",
      "destination": "/producto"
    },
    {
      "source": "/:cat/:sub",
      "destination": "/categoria"
    },
    {
      "source": "/:cat((?!admin|api|_next|static|images|distribuidores|contacto|sostenibilidad|nosotros|.*\\..*).*)",
      "destination": "/categoria"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin"
    },
    {
      "source": "/producto/:path*",
      "destination": "/producto"
    },
    {
      "source": "/categoria/:path*",
      "destination": "/categoria"
    },
    {
      "source": "/:cat/:sub/:item",
      "destination": "/producto"
    },
    {
      "source": "/:cat/:sub",
      "destination": "/categoria"
    },
    {
      "source": "/:cat((?!admin|api|_next|static|images|.*\\..*).*)",
      "destination": "/categoria"
    }
  ]
}
